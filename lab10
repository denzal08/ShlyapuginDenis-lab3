def binary_search_first(lst, target):
    left, right = 0, len(lst) - 1
    result = -1
    while left <= right:
        mid = (left + right) // 2
        if lst[mid] == target:
            result = mid
            right = mid - 1
        elif lst[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
    return result
